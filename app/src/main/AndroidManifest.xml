<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- टेम्पलेट कमांड: "सुबह 7 बजे का अलार्म लगाओ" / "10 मिनट का टाइमर" (घड़ी ऐप में, normal permission) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- v3.40: DK लाइव स्क्रीन शेयर (सिर्फ़ आपके कहने पर, बंद से शुरू) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- नवंबर 2026: आवाज़ से अनलॉक - Android 14+ पर स्क्रीन जगाने के लिए -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- नवंबर 2026: ब्राइटनेस / ऑटो रोटेट (user खुद "सिस्टम सेटिंग बदलें" में Allow करता है) और डू नॉट डिस्टर्ब -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- v3.39: Android 11 तक Bluetooth headset का माइक (SCO) चालू करने के लिए; 12+ पर setCommunicationDevice -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v3.45: सच्चा दोस्त - ऐप खुलते समय ताज़ा लोकेशन (मौसम/इलाके की खबर). कहीं सेव नहीं होती -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- v3.33 (वैकल्पिक): "राहुल को कॉल करो" = सीधी कॉल (न दें तो डायलर में नंबर भरता है) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- v3.33 (वैकल्पिक): "सबसे नई फ़ोटो दिखाओ" (न दें तो सिर्फ़ गैलरी खुलती है). सिर्फ़ फ़ोटो पढ़ना - मिटाना नहीं -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- नवंबर 2026: फ़ोटो / स्क्रीनशॉट मिटाते समय हर बार Allow न पूछे (Android 12+, सेटिंग्स से मालिक चालू करे) -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- नवंबर 2026: "X वाली फ़ाइल WhatsApp पर भेजो" - Download / Documents की फ़ाइल ढूँढने के लिए (मालिक Settings में खुद चालू करता है) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- CALL_PHONE से Android "फ़ोन वाला डिवाइस ज़रूरी" मान लेता है - टैबलेट पर भी चले -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- adb se di jaaye to DK apni Accessibility khud ON rakhta hai -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- नवंबर 2026: पेमेंट ऐप से बाहर आना पहचानने के लिए (Usage access - आप Settings में देते हैं) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Phone ke saare launcher apps ki list dekhne ke liye (open_app के लिए) -->
    <queries>
        <!-- नवंबर 2026: फ़ोन के पेमेंट (UPI) ऐप पहचानने के लिए -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- DK AI Part 12: Instagram/Facebook के share निशाने (Feed/Stories/Reels) चुनने के लिए -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- नवंबर 2026: ऑटो रिप्लाई - फ़ोन में कौन-से मैसेज ऐप हैं -->
        <package android:name="org.telegram.messenger" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="org.thoughtcrime.securesms" />
    </queries>

    <application
        android:name=".DKApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/dkai_network"
        android:theme="@style/Theme.DK">

        <!-- v3.66: ONNX Runtime का telemetry provider नहीं (कुछ भी बाहर न जाए, और x86 पर .so के बिना ऐप न रुके) -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <activity
            android:name=".DKAssistActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.dk.assistant.DKVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name="com.dk.assistant.DKVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="false" />

        <service
            android:name="com.dk.assistant.DKRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <activity
            android:name=".template.TemplateSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auto.AutoSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TeacherActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop" />

        <!-- v3.40: स्क्रीन शेयर की Android इजाज़त (पारदर्शी, बिना UI) + शेयर चलने तक service -->
        <activity
            android:name=".ScreenShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- v3.67: फ़ोटो मिटाने की Android "Allow" खिड़की (पारदर्शी, बिना UI) -->
        <activity
            android:name=".DeleteMediaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- v3.58: पहली बार का परिचय (सिर्फ़ नए install पर) -->
        <activity
            android:name=".onboard.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Coding agent (GitHub) - settings se chalu -->
        <activity
            android:name=".StoryWriterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CodingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <!-- DK कंप्यूटर: कई कदम वाला एजेंट (search, वेब, कोड, फ़ाइलें, फ़ोन, कोडिंग, रिमाइंडर) -->
        <!-- DK AI: Website Forge - 3D में बनती वेबसाइट + तैयार वेबसाइट -->
        <!-- DK AI Part 12: गैलरी -> Share -> DK (यही फ़ोटो/वीडियो DK पोस्ट कर सकता है) -->
        <activity
            android:name=".agent.android.ShareToDKActivity"
            android:exported="true"
            android:label="DK को दें"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".forge.ForgeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- नवंबर 2026: ऐप स्टूडियो (फ़ोन पर ऐप बनाना + चलता preview) -->
        <activity
            android:name=".studio.StudioActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ComputerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".ComputerAlarm"
            android:exported="false" />

        <!-- नवंबर 2026: फ़ोन कंट्रोल (Accessibility) रुका तो ठीक करना / बताना - Active apps के Stop के बाद भी चलता है -->
        <service
            android:name=".A11yWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".MicOffReceiver"
            android:exported="false" />

        <!-- v3.6: हर 6 घंटे अपडेट जाँच (JobScheduler, restart के बाद भी) -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- v3.88: लोकल याददाश्त - रोज़ सार + 30 दिन से पुरानी बातें मिटाना -->
        <receiver
            android:name=".LocalMemoryReceiver"
            android:exported="false" />

        <!-- नवंबर 2026: ✕ से छिपे ORB को notification के "ORB दिखाओ" बटन से वापस लाना -->
        <receiver
            android:name=".OrbShowReceiver"
            android:exported="false" />

        <!-- 12 नवंबर 2026: DK लाइव की notification के "कॉल काटें" / "म्यूट" बटन -->
        <receiver
            android:name=".LiveNotifyReceiver"
            android:exported="false" />

        <!-- v5.1: DK Inspector - हर 20 मिनट पूरे ऐप की जाँच (सिर्फ़ पढ़ना) -->
        <receiver
            android:name=".inspector.InspectorReceiver"
            android:exported="false" />

        <!-- फ़ोन restart / ऐप update के बाद DK कंप्यूटर के तय काम फिर से लगाना -->
        <receiver
            android:name=".ComputerBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/computer_files" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- v3.72: कनेक्टर हब (Google / GitHub / Facebook Page / Instagram / MCP) -->
        <!-- नवंबर 2026: सेटिंग्स → बैकअप (याददाश्त Google Drive में) -->
        <activity
            android:name=".backup.BackupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".connect.ConnectorsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- नवंबर 2026: आवाज़ से अनलॉक - लॉक स्क्रीन पर स्क्रीन जगाकर Android से PIN वाला हिस्सा माँगती है (पारदर्शी, खुद बंद) -->
        <activity
            android:name=".UnlockWakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:targetApi="27" />

        <!-- नवंबर 2026: "Hey DK किधर हो" - लॉक स्क्रीन के ऊपर "मैं इधर हूँ बॉस", छूते ही बजना बंद -->
        <activity
            android:name=".FindPhoneActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            tools:targetApi="27" />

        <!-- नवंबर 2026: गार्ड मोड - कोई फ़ोन छुए तो लॉक स्क्रीन के ऊपर लाल चेतावनी + सायरन (छूने से बंद नहीं) -->
        <activity
            android:name=".GuardAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            tools:targetApi="27" />

        <!-- Phone control: screen padhna, click, type, scroll, screenshot -->
        <service
            android:name=".DKAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- v3.41: notification padhna + reply (user Settings me "Notification access" deta hai) -->
        <service
            android:name=".DKNotifListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Background me mic chalu rakhne ke liye notification service -->
        <receiver
            android:name=".PayGuardReceiver"
            android:exported="false" />

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

    </application>
</manifest>