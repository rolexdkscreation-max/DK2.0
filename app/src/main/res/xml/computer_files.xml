<?xml version="1.0" encoding="utf-8"?>
<!-- DK कंप्यूटर की बनाई फ़ाइलें खोलने/शेयर करने के लिए -->
<paths>
    <external-files-path name="computer" path="computer/" />
    <files-path name="computer_internal" path="computer/" />
    <!-- DK AI Website Forge की बनी वेबसाइटें (filesDir/Websites) -->
    <files-path name="websites" path="Websites/" />
    <!-- DK AI Part 12: यूज़र ने DK को share की फ़ोटो/वीडियो (filesDir/shared_media) -->
    <files-path name="shared_media" path="shared_media/" />
    <!-- DK टीचर: व्हाइटबोर्ड की फ़ोटो शेयर (cacheDir/images) -->
    <cache-path name="teacher_board" path="images/" />
    <!-- कैमरा और अन्य कैश फाइलों के लिए रूट पाथ -->
    <cache-path name="cache_root" path="." />
    <!-- नवंबर 2026: WhatsApp पर भेजने के लिए फ़ोन की फ़ाइल (Download / Documents…) - "सभी फ़ाइलें" इजाज़त के बाद -->
    <external-path name="storage" path="." />
    <!-- 13 नवंबर 2026: DK AI Broadcast Studio की बनी आवाज़ (filesDir/dkai_broadcast) शेयर -->
    <files-path name="dkai_broadcast" path="dkai_broadcast/" />
    <!-- 14 नवंबर 2026: DKAI Terminal की `apk` कमांड से बने ऐप (filesDir/dkai/apks) - इंस्टॉल करने के लिए -->
    <files-path name="dkai_apks" path="dkai/apks/" />
</paths>
