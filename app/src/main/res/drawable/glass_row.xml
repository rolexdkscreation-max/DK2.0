<?xml version="1.0" encoding="utf-8"?>
<!-- Card ke andar ki list row: halka kaanch, dabaane par roshan -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#40FFFFFF" /><stroke android:width="1dp" android:color="#B3FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#1AFFFFFF" /><stroke android:width="1dp" android:color="#40FFFFFF" /></shape>
    </item>
</selector>
