<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#22FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="270" android:startColor="#D91A2148" android:endColor="#D90E1335" />
        </shape>
    </item>
</layer-list>
