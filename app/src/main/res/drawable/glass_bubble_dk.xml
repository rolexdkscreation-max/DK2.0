    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="rectangle">
        <corners android:topLeftRadius="21dp" android:topRightRadius="21dp" android:bottomLeftRadius="5dp" android:bottomRightRadius="21dp" />
