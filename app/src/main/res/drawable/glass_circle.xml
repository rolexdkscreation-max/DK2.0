<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy gol icon button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#F2FFFFFF" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#FF6A9BE8" android:endColor="#FF4A7FD6" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval">
                <gradient android:angle="300" android:startColor="#E6FFFFFF" android:centerColor="#4DFFFFFF" android:endColor="#99FFFFFF" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#FF4F86DC" android:endColor="#FF3A6DC4" /></shape></item>
            <item android:left="5dp" android:top="2dp" android:right="5dp" android:bottom="22dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#55FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
