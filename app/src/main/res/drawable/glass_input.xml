<?xml version="1.0" encoding="utf-8"?>
<!-- Glass likhne ka dabba: focus par chamakta safed kinara -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="140" android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#FF3A6DC4" android:endColor="#FF3567BD" />
            <stroke android:width="1.5dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#FF2E60B6" android:endColor="#FF2B5AAE" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
        </shape>
    </item>
</selector>
