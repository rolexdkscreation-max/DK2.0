<?xml version="1.0" encoding="utf-8"?>
<!-- Gol glossy neela button (bhejein / mic) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#FF2F67E8" android:endColor="#FF1D4FCB" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#99CFE4FF" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#FF4C8DFF" android:endColor="#FF2257D6" /></shape></item>
            <item android:left="6dp" android:top="2dp" android:right="6dp" android:bottom="24dp">
                <shape android:shape="oval"><gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
