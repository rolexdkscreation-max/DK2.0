<resources>
    <style name="Theme.DK" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#3D7BFF</item>
        <item name="colorSecondary">#9FD3FF</item>
        <item name="colorAccent">#9FD3FF</item>
        <item name="android:windowBackground">@drawable/bg_sky</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#D9FFFFFF</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="android:textColorLink">#D6EEFF</item>
        <item name="colorControlNormal">#B3FFFFFF</item>
        <item name="colorControlActivated">#FFFFFFFF</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="colorSwitchThumbNormal">#E6F0FF</item>
        <item name="android:colorControlActivated">#FFFFFFFF</item>
        <item name="android:windowAnimationStyle">@style/DK.WindowAnim</item>
        <item name="android:buttonStyle">@style/DK.Button</item>
        <item name="android:imageButtonStyle">@style/DK.ImageButton</item>
        <item name="android:alertDialogTheme">@style/Theme.DK.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.DK.Dialog.Compat</item>
    </style>

    <!-- Glass dialog (android.app.AlertDialog) -->
    <style name="Theme.DK.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:colorPrimary">#3D7BFF</item>
        <item name="android:colorControlActivated">#FFFFFFFF</item>
        <item name="android:colorControlNormal">#B3FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#D9FFFFFF</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFFFF</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowAnimationStyle">@style/DK.DialogAnim</item>
        <item name="android:buttonBarButtonStyle">@style/DK.DialogButton</item>
    </style>
    <style name="Theme.DK.Dialog.Compat" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="colorAccent">#FFFFFFFF</item>
        <item name="colorPrimary">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#D9FFFFFF</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>
    <style name="DK.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DK.Button" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="DK.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="DK.WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/glass_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/glass_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/glass_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/glass_close_exit</item>
    </style>
    <style name="DK.DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/glass_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/glass_dialog_out</item>
    </style>
</resources>
