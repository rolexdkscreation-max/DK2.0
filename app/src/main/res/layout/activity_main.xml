<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_space_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Top App Bar: Frosted container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="मेनू खोलें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="नमस्ते सर 😊\nइतनी देर कहाँ थे?"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DK Voice Assistant"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHomeCam"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="कैमरा"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_primary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnHomeShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="स्क्रीन शेयर"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_screen_share"
                app:tint="@color/text_primary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="म्यूट करें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="सेटिंग्स"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alertRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/chipUpdate" style="@style/DKChip"
                android:background="@drawable/btn_accent"
                android:text="⬆ नया अपडेट"
                android:visibility="gone" />
            <TextView android:id="@+id/chipKey" style="@style/DKChip"
                android:background="@drawable/btn_accent"
                android:text="🔑 Access key चालू नहीं"
                android:contentDescription="Access key की सेटिंग खोलें"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Central Holographic 3D Energy Orb & Waveform -->
        <FrameLayout
            android:id="@+id/orbBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <com.dk.assistant.OrbView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="बोलने के लिए टैप करें" />

            <ImageView
                android:id="@+id/orbMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnOrbMin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="ओर्ब छोटा करें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minimize"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/txtState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="सुन रहा हूँ..."
                android:textColor="@color/neon_electric_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Recent Interaction Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="नमस्ते सर भी चौन होना इतनी देर कहाँ चेली है?"
                android:textColor="@color/neon_electric_cyan"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtDk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="DK: केवल वोच चानी कर अपना तालमेल पाकर ले सुधारा अवगाह कार्य करता है।"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Control Deck (bg_glow_dock) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glow_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_card"
                android:text="Keyboard"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="टूल"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                app:tint="@color/text_primary" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Type a message..."
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                app:backgroundTint="@color/neon_electric_cyan"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_mic"
                app:tint="@color/bg_space_dark" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>