<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky">

    <com.dk.assistant.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- upar: naam + settings + mute button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- v4: मेनू (चैट, लाइव आवाज़, मेमोरी, DK कंप्यूटर, वेबसाइट, सेटिंग्स) - होम पर बड़े कार्ड/नीचे की बार नहीं -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="मेनू खोलें"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="नमस्ते"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DK"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="म्यूट करें"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="सेटिंग्स"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- status chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipAccess" style="@style/DKChip" />
                <TextView android:id="@+id/chipMic" style="@style/DKChip" />
                <TextView android:id="@+id/chipComputer" style="@style/DKChip"
                    android:drawableStart="@drawable/ic_s_computer"
                    android:text="DK कंप्यूटर"
                    android:contentDescription="DK कंप्यूटर खोलें" />
                <TextView android:id="@+id/chipForge" style="@style/DKChip"
                    android:drawableStart="@drawable/ic_globe"
                    android:text="वेबसाइट"
                    android:contentDescription="वेबसाइट बनाने वाला Forge खोलें" />
                <TextView android:id="@+id/chipUpdate" style="@style/DKChip"
                    android:background="@drawable/btn_accent"
                    android:text="⬆ नया अपडेट"
                    android:visibility="gone" />
                <TextView android:id="@+id/chipKey" style="@style/DKChip"
                    android:background="@drawable/btn_accent"
                    android:text="🔑 Access key चालू नहीं"
                    android:contentDescription="Access key की सेटिंग खोलें"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- beech me ORB -->
        <FrameLayout
            android:id="@+id/orbBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.dk.assistant.OrbView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="बोलने के लिए टैप करें" />

            <!-- v3.71: ORB की जगह लड़की अवतार (सेटिंग्स → ORB → अवतार चुनो) -->
            <com.dk.assistant.avatar.AvatarView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="बोलने के लिए टैप करें"
                android:visibility="gone" />

            <!-- v4: नियॉन ओर्ब के बीच माइक (सिर्फ़ निशान - टैप ओर्ब ही लेता है) -->
            <ImageView
                android:id="@+id/orbMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />

            <!-- orb chhota/bada karne ka button -->
            <ImageButton
                android:id="@+id/btnOrbMin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="ओर्ब छोटा करें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minimize" />

            <TextView
                android:id="@+id/txtState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/glass_pill"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="ओर्ब पर टैप करके बोलिए"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- aakhri baat (chhoti line) -->
        <TextView
            android:id="@+id/txtDk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text2"
            android:textSize="13sp" />

    </LinearLayout>
</FrameLayout>