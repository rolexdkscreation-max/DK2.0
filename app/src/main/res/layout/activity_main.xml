<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_space_dark">

    <!-- नवंबर 2026 (मालिक, संदर्भ चित्र): पूरी थीम की पृष्ठभूमि (चित्र + धीमी रोशनी) - ui/ThemePacks -->
    <com.dk.assistant.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Top App Bar (संदर्भ चित्र): काँच की पट्टी - ≡ | नाम (बीच में) | बटन -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="मेनू खोलें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/txtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="DK Voice Assistant"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHomeCam"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="कैमरा से दिखाएँ"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnHomeShare"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="स्क्रीन शेयर"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_screen_share"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="म्यूट करें"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="सेटिंग्स"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- बड़ा अभिवादन (संदर्भ चित्र: "नमस्ते सर 😊") - समय के हिसाब से, MainActivity भरता है -->
        <TextView
            android:id="@+id/txtHello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#AA22D3EE"
            android:shadowRadius="12"
            android:text="नमस्ते"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/alertRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/chipUpdate" style="@style/DKChip"
                android:background="@drawable/btn_accent"
                android:text="⬆ नया अपडेट"
                android:visibility="gone" />
            <TextView android:id="@+id/chipKey" style="@style/DKChip"
                android:background="@drawable/btn_accent"
                android:text="🔑 Access key चालू नहीं"
                android:contentDescription="Access key की सेटिंग खोलें"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Central Holographic 3D Energy Orb & Waveform -->
        <FrameLayout
            android:id="@+id/orbBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <com.dk.assistant.OrbView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="बोलने के लिए टैप करें" />

            <ImageView
                android:id="@+id/orbMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnOrbMin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="ओर्ब छोटा करें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minimize"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/txtState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp"
                android:letterSpacing="0.04"
                android:shadowColor="#CC22D3EE"
                android:shadowRadius="14"
                android:text="ओर्ब पर टैप करके बोलिए"
                android:textColor="@color/neon_electric_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Gradient waveform (cyan → violet): DKState की असली हालत/माइक से चलती है (HoloWaveView) -->
        <com.dk.assistant.HoloWaveView
            android:id="@+id/homeWave"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <!-- Recent Interaction Box: DK की आख़िरी बात (MainActivity भरता है; ओर्ब छोटा = यह डिब्बा बड़ा) -->
        <LinearLayout
            android:id="@+id/dkBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txtDk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- नीचे का डॉक: + | लिखने की जगह | चमकता नियॉन माइक (छल्लों के साथ)
             + = फोटो / फ़ाइल अपलोड (DK कंप्यूटर में), लिखने की जगह = चैट, माइक = लाइव आवाज़.
             नवंबर 2026 मालिक: "कीबोर्ड" पिल हटाई, + उसकी जगह सबसे पहले -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_composer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btnDockTools"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="फोटो या फ़ाइल जोड़ें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/btnDockType"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="लिखकर पूछें…"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.dk.assistant.NeonMicView
                android:id="@+id/btnDockMic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="बोलने के लिए टैप करें" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
