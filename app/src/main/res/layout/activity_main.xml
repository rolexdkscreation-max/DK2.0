<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.dk.assistant.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- upar: naam + settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="नमस्ते"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DK"
                    android:textColor="@color/text"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/glass_circle"
                android:contentDescription="सेटिंग्स"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- status chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipAccess" style="@style/DKChip" />
                <TextView android:id="@+id/chipMic" style="@style/DKChip" />
                <TextView android:id="@+id/chipAi" style="@style/DKChip" />
                <TextView android:id="@+id/chipUpdate" style="@style/DKChip"
                    android:background="@drawable/btn_accent"
                    android:text="⬆ नया अपडेट"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- beech me ORB -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.dk.assistant.OrbView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="बोलने के लिए टैप करें" />

            <TextView
                android:id="@+id/txtState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/glass_pill"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="ओर्ब पर टैप करके बोलिए"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- baatcheet card (tap = chat screen) -->
        <LinearLayout
            android:id="@+id/cardTalk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="आप: —"
                android:textColor="@color/text2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="DK: —"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- likhne wali bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/edtCmd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="लिखकर कमांड दीजिए…"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:textColor="@color/text"
                android:textColorHint="@color/text3"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="भेजें"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_accent_circle"
                android:contentDescription="बोलें"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
